---
import { isoDay, monthDay, year, type PostSummary } from '@tamable/blog-kit'

interface Props {
  posts: PostSummary[]
  byYear?: boolean
  showTags?: boolean
}

const { posts, byYear = false, showTags = false } = Astro.props

function groups() {
  if (!byYear) return [{ year: '', posts }]
  const grouped = new Map<string, PostSummary[]>()
  for (const post of posts) {
    const key = post.publishedAt ? year(post.publishedAt) : ''
    grouped.set(key, [...(grouped.get(key) ?? []), post])
  }
  return [...grouped].map(([year, posts]) => ({ year, posts }))
}

function date(post: PostSummary) {
  if (!post.publishedAt) return ''
  return byYear ? monthDay(post.publishedAt) : isoDay(post.publishedAt)
}
---

<div class="post-list">
  {groups().map(group => (
    <section aria-label={group.year || undefined}>
      {group.year && <h2 class="year">{group.year}</h2>}
      <div class="rows">
        {group.posts.map(post => (
          <article class="row">
            <p class="when">
              {post.publishedAt && <time datetime={post.publishedAt}>{date(post)}</time>}
              {post.readingMinutes && <Fragment><br />{post.readingMinutes} min</Fragment>}
            </p>
            <div class="what">
              <h3 class="title"><a href={post.path}>{post.title}</a></h3>
              {post.excerpt && <p class="excerpt">{post.excerpt}</p>}
              {showTags && post.tags.length > 0 && (
                <p class="tags">
                  {post.tags.map(tag => <a href={`/tags/${tag.slug}`}>{tag.name}</a>)}
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  .year {
    margin: 0 0 4px;
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
  }

  .rows {
    border-top: 1px solid var(--border);
  }

  section + section {
    margin-top: 40px;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    column-gap: 40px;
    row-gap: 8px;
    padding-block: 28px;
    border-bottom: 1px solid var(--border);
  }

  .when {
    flex: 0 0 120px;
    margin: 4px 0 0;
    font-size: 14px;
    color: var(--muted);
  }

  .what {
    flex: 999 1 400px;
    min-width: 0;
  }

  .title {
    margin: 0 0 8px;
    font-size: 22px;
    line-height: 1.3;
    font-weight: 600;
  }

  .title a {
    color: var(--text);
    text-decoration: none;
  }

  .title a:hover {
    color: var(--link);
  }

  .excerpt {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--text-soft);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 10px 0 0;
    font-size: 13px;
  }

  .tags a {
    text-decoration: none;
  }
</style>
