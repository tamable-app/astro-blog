---
import { BLOG_PATH, SERIES_PATH } from '@tamable/blog-kit'
import site from '../../site.config'
import ThemeToggle from './ThemeToggle.astro'

const path = Astro.url.pathname

// Every blog page lives under /blog, so Blog stays lit on its series and tag pages too. Series is lit
// on its own pages as well; the most specific link is the page, the other only marks the section.
const links = [
  { label: 'Blog', to: BLOG_PATH },
  { label: 'Series', to: SERIES_PATH },
  { label: 'About', to: '/about' },
]

const within = (section: string) => path === section || path.startsWith(`${section}/`)
const deepest = links.filter(link => within(link.to)).sort((a, b) => b.to.length - a.to.length)[0]

function ariaCurrent(link: (typeof links)[number]) {
  if (link === deepest) return 'page'
  return within(link.to) ? 'true' : undefined
}
---

<header class="site-header container">
  <a href="/" class="home">{site.name}</a>
  <nav aria-label="Main" class="nav">
    {links.map(link => (
      <a
        href={link.to}
        class:list={['nav-link', { current: within(link.to) }]}
        aria-current={ariaCurrent(link)}
      >
        {link.label}
      </a>
    ))}
    <ThemeToggle />
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 32px;
    border-bottom: 1px solid var(--border);
  }

  .home {
    font-size: 16px;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    font-size: 14px;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    color: var(--text-soft);
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--text);
  }

  .nav-link.current {
    color: var(--link);
  }

  @media (max-width: 480px) {
    .nav-link {
      padding: 0 7px;
    }
  }
</style>
