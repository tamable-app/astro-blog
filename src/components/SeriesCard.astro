---
import type { SeriesSummary } from '@tamable/blog-kit'

interface Props {
  series: SeriesSummary
}

const { series } = Astro.props
---

<a href={`/series/${series.slug}`} class="series-card">
  <span class="title">{series.title}</span>
  {series.description && <span class="description">{series.description}</span>}
  <span class="count">{series.postCount} {series.postCount === 1 ? 'part' : 'parts'}</span>
</a>

<style>
  .series-card {
    flex: 1 1 320px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }

  .series-card:hover {
    border-color: var(--border-strong);
  }

  .count {
    font-size: 13px;
    color: var(--muted);
  }

  .title {
    font-size: 22px;
    line-height: 1.3;
    font-weight: 600;
  }

  .description {
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-soft);
  }
</style>
