---
// Every block Tamable can serve, for checking the post styles. Only added by `astro dev`.
import { prepareHtml } from '@tamable/blog-kit'
import fixture from '@tamable/blog-kit/fixtures/posts/hello-world.json'
import Layout from '../layouts/Layout.astro'

const html = prepareHtml(`<p>Inline: <strong>bold</strong>, <em>italic</em>, <u>underline</u>, <s>strike</s>, <mark>highlight</mark>, <code>inline code</code>.</p><ul><li><p>One</p></li><li><p>Two</p></li></ul><ol start="3"><li><p>Three</p></li></ol><hr>${fixture.data.html}`)
---

<Layout title="Blocks" robots="noindex" canonical={null}>
  <article class="container-reading" style="padding-block: 64px">
    <h1 class="page-title">Blocks</h1>
    <div class="prose" set:html={html} />
  </article>
</Layout>
