# Tamable: Settings › Sites › your site
TAMABLE_API_URL=https://api.tamable.app/api/v1
TAMABLE_READ_KEY=
TAMABLE_WEBHOOK_SECRET=
# Your host's build hook (Forge, Netlify, Vercel, Cloudflare Pages...), called on each content change
DEPLOY_HOOK_URL=
# The canonical address, with no trailing slash
SITE_URL=https://example.com
# true to allow a build with no published posts
ALLOW_EMPTY_BLOG=
